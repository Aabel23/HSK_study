# Biến môi trường tuỳ chọn cho Chinese Study.
# Mọi giá trị đều có mặc định an toàn cho máy cá nhân — chỉ đặt khi cần đổi.
# Sao chép thành `.env` và nạp bằng công cụ bạn dùng (`.env` không được commit).

# --- Chạy ứng dụng ----------------------------------------------------------
CHINESE_STUDY_ENV=development          # development | production
CHINESE_STUDY_HOST=127.0.0.1
CHINESE_STUDY_PORT=8000
CHINESE_STUDY_NO_BROWSER=0             # 1 = không tự mở trình duyệt khi khởi động

# --- Dữ liệu ----------------------------------------------------------------
CHINESE_STUDY_DB=data/chinese_study.db
CHINESE_STUDY_AUDIO_DIR=data/audio_cache
CHINESE_STUDY_SEED=1                   # 1 = nạp dữ liệu HSK khi khởi động

# --- API --------------------------------------------------------------------
CHINESE_STUDY_DOCS=1                   # 1 = bật /api/docs và /api/redoc
CHINESE_STUDY_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
CHINESE_STUDY_AUDIO_RATE_LIMIT=240     # request/phút cho endpoint audio, 0 = tắt
CHINESE_STUDY_REQUEST_TIMEOUT=60

# --- Log --------------------------------------------------------------------
CHINESE_STUDY_LOG_LEVEL=INFO           # DEBUG | INFO | WARNING | ERROR
CHINESE_STUDY_LOG_JSON=0               # 1 = log dạng JSON

# --- Ủng hộ qua PayOS (tuỳ chọn) ---------------------------------------------
# Bỏ trống = tab "Donate cho anh Ba" hiện hướng dẫn cấu hình thay vì form.
# Lấy khoá tại https://my.payos.vn → Kênh thanh toán → Chi tiết.
# ĐỪNG đưa khoá thật vào file này (file này ĐƯỢC commit) — đặt trong `.env`.
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=

CHINESE_STUDY_DONATE_NAME=anh Ba       # tên người nhận hiển thị trên trang
CHINESE_STUDY_DONATE_MIN=2000          # số tiền tối thiểu (VND)
CHINESE_STUDY_DONATE_MAX=10000000      # số tiền tối đa (VND)
# Chỉ đặt khi app chạy sau domain/proxy: URL công khai để PayOS quay lại sau
# khi chuyển khoản. Bỏ trống = tự lấy từ origin của trình duyệt.
CHINESE_STUDY_DONATE_BASE_URL=

# --- Chấm điểm phần nói bằng AI (tuỳ chọn) -----------------------------------
# Bỏ trống = phần thi nói trong "Thi thử HSK" chuyển sang chế độ tự chấm.
# Lấy khoá tại https://aistudio.google.com/apikey (khoá dạng AIza...).
# Nếu dùng OAuth access token (dạng ya29.../AQ....) thì app tự gửi bằng header
# Authorization: Bearer — nhưng token loại này hết hạn sau ít phút.
# ĐỪNG đưa khoá thật vào file này (file này ĐƯỢC commit) — đặt trong `.env`.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_TIMEOUT=60
