# Biến môi trường tuỳ chọn cho Chinese Study.
# Mọi giá trị đều có mặc định an toàn cho máy cá nhân — chỉ đặt khi cần đổi.
# Sao chép thành `.env` và nạp bằng công cụ bạn dùng (`.env` không được commit).

# --- Chạy ứng dụng ----------------------------------------------------------
CHINESE_STUDY_ENV=development          # development | production
CHINESE_STUDY_HOST=127.0.0.1
CHINESE_STUDY_PORT=8000
CHINESE_STUDY_NO_BROWSER=0             # 1 = không tự mở trình duyệt khi khởi động

# --- Dữ liệu ----------------------------------------------------------------
CHINESE_STUDY_DB=data/chinese_study.db
CHINESE_STUDY_AUDIO_DIR=data/audio_cache
CHINESE_STUDY_SEED=1                   # 1 = nạp dữ liệu HSK khi khởi động

# --- API --------------------------------------------------------------------
CHINESE_STUDY_DOCS=1                   # 1 = bật /api/docs và /api/redoc
CHINESE_STUDY_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
CHINESE_STUDY_AUDIO_RATE_LIMIT=240     # request/phút cho endpoint audio, 0 = tắt
CHINESE_STUDY_REQUEST_TIMEOUT=60

# --- Log --------------------------------------------------------------------
CHINESE_STUDY_LOG_LEVEL=INFO           # DEBUG | INFO | WARNING | ERROR
CHINESE_STUDY_LOG_JSON=0               # 1 = log dạng JSON
