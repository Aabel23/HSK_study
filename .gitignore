# --- Python -----------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
.venv/
venv/
env/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# --- Node / web frontend ----------------------------------------------------
# frontend-web/dist/ IS committed: Render's deploy environment has no Node,
# so the built SPA ships as tracked static files. Rebuild + commit after
# changing frontend-web/src.
node_modules/
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Build artefacts (PyInstaller) ------------------------------------------
/build/
/dist/
*.exe
*.msi

# --- Local user data --------------------------------------------------------
# The SQLite database and the generated audio cache are per-machine state,
# not source. The folder itself is kept via data/.gitkeep.
/data/*
!/data/.gitkeep

# --- Environment & logs -----------------------------------------------------
.env
.env.*
!.env.example
*.log
logs/

# --- Vendored helper skill (not part of the application) --------------------
ui-ux-pro-max-skill/

# --- OS / editors -----------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
